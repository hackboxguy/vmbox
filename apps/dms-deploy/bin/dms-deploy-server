#!/usr/bin/env python3
"""
dms-deploy-server - the one screen the customer sees.

Serves a single page on :8080. It shows whether an AGX board is in recovery mode, flashes the
baked DMS image when the user clicks the button, and streams the flash log back.

Deliberately thin: it shells out to /app/dms-deploy/bin/jetson-flash.sh, which is the exact
path validated on hardware. This process must never become a second implementation of the
flash -- if the UI is broken, `jetson-flash.sh` alone must still work over SSH.

Python 3 standard library only (the Alpine rootfs has python3 and nothing else installed).
"""
import json
import os
import re
import signal
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

APP_DIR = "/app/dms-deploy"
WWW = f"{APP_DIR}/share/www"
FLASH_SH = f"{APP_DIR}/bin/jetson-flash.sh"
STATE_DIR = "/data/app-data/dms-deploy"
LOG_FILE = f"{STATE_DIR}/flash.log"
PREV_LOG = f"{STATE_DIR}/flash.log.prev"
PORT = 8080

# The board's USB vendor ID in recovery mode. Detection is `lsusb`-only, ON PURPOSE:
# the Tegra bootrom's RCM handshake is ONE-SHOT, so probing with tegrarcm (even a read-only
# --uid) consumes the session and the subsequent flash fails. Never "just check" the board.
JETSON_VID = "0955"

# Stall detection, and why the two limits differ by so much.
#
# MEASURED on a healthy flash: once tegraflash reaches "Writing partition APP with system.img"
# it prints its whole progress bar up front and then writes the 12 GB image in SILENCE for
# ~1550 s. So "no output for 5 minutes" would abort a perfectly good flash mid-write.
#
# Before that point the chain is chatty -- it never goes quiet for more than a few seconds.
# Both observed real-world hangs died there: tegrarcm_v2 blocked on a USB read that never
# returned ("BootRom is not running") and sat there, silent, for over half an hour, with the
# UI happily reporting "flashing". That is the case this catches.
STALL_BEFORE_WRITE = 240       # 4 min of silence before the write begins = the board is gone
STALL_DURING_WRITE = 3600      # 60 min: generous; the write itself is legitimately silent
WRITE_MARKER = "Writing partition APP with system"

_lock = threading.Lock()
_flash = {"state": "idle", "started": 0.0, "ended": 0.0, "rc": None, "reason": ""}
_proc = None


def board_present() -> bool:
    try:
        out = subprocess.run(["lsusb"], capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return False
    return f"{JETSON_VID}:" in out


def image_version() -> str:
    try:
        with open(f"{APP_DIR}/IMAGE_VERSION") as f:
            return f.read().strip()
    except OSError:
        return "unknown"


def read_log() -> str:
    try:
        with open(LOG_FILE, "r", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


# Coarse progress, derived from what tegraflash actually prints.
PHASES = [
    (re.compile(r"Boot Rom communication completed|RCM version", re.I), "Board accepted the recovery handshake"),
    (re.compile(r"Sending BCTs|Sending bct", re.I), "Sending bootloader"),
    (re.compile(r"Erasing", re.I), "Erasing eMMC"),
    (re.compile(WRITE_MARKER, re.I), "Writing the DMS image (~25 min, and the log stays quiet while it does)"),
    (re.compile(r"Flashing completed", re.I), "Flash complete"),
]


def current_phase(log: str) -> str:
    phase = "Starting"
    for line in log.splitlines():
        for pat, name in PHASES:
            if pat.search(line):
                phase = name
    return phase


def fail(reason: str):
    with _lock:
        _flash["state"] = "failed"
        _flash["ended"] = time.time()
        _flash["reason"] = reason


def watchdog():
    """Kill a flash that has stopped making progress, and say so in plain language.

    Without this the UI reports "flashing" forever while tegrarcm_v2 blocks on a dead USB
    device -- which is exactly what happened twice on a Windows host. A field engineer has no
    way to tell that apart from a slow flash.
    """
    last_size, last_change = -1, time.time()
    while True:
        time.sleep(10)
        with _lock:
            if _flash["state"] != "flashing":
                return
        try:
            size = os.path.getsize(LOG_FILE)
        except OSError:
            size = 0
        if size != last_size:
            last_size, last_change = size, time.time()
            continue

        writing = WRITE_MARKER.lower() in read_log().lower()
        limit = STALL_DURING_WRITE if writing else STALL_BEFORE_WRITE
        if time.time() - last_change < limit:
            continue

        # Stalled. Kill the whole process group -- flash.sh spawns tegraflash/tegrarcm children.
        with _lock:
            p = _proc
        if p and p.poll() is None:
            try:
                os.killpg(os.getpgid(p.pid), signal.SIGKILL)
            except OSError:
                pass
        if writing:
            fail("The image write stopped making progress. Power-cycle the board back into "
                 "recovery mode and try again.")
        else:
            fail("The board stopped responding before the image write began — it is no longer "
                 "reachable over USB. Power-cycle the board (remove power, then FORCE RECOVERY "
                 "+ RESET) and try again. If this repeats, connect the board directly to the PC "
                 "rather than through a hub or docking station.")
        return


def run_flash():
    """Run jetson-flash.sh, appending everything to LOG_FILE. Exactly one invocation."""
    global _proc
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(LOG_FILE, "wb", buffering=0) as log:
        try:
            # start_new_session: gives the flash its own process group, so the watchdog and the
            # Cancel button can kill tegraflash's children too, not just the shell.
            p = subprocess.Popen(
                ["/bin/sh", FLASH_SH],
                stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                start_new_session=True,
            )
            with _lock:
                _proc = p
            rc = p.wait()
        except Exception as e:
            log.write(f"\nfailed to launch {FLASH_SH}: {e}\n".encode())
            rc = 127

    with _lock:
        # The watchdog or Cancel may have already killed it and set a reason; don't overwrite.
        if _flash["state"] != "flashing":
            return
        _flash["rc"] = rc
        _flash["ended"] = time.time()
        _flash["state"] = "done" if rc == 0 else "failed"
        if rc != 0:
            _flash["reason"] = f"The flash failed (exit code {rc}). See the log below."


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *_args):
        pass  # the access log is noise; the flash log is what matters

    def _send(self, code, body: bytes, ctype="application/json"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _json(self, code, obj):
        self._send(code, json.dumps(obj).encode())

    def do_GET(self):
        path = urlparse(self.path).path
        if path in ("/", "/index.html"):
            try:
                with open(f"{WWW}/index.html", "rb") as f:
                    self._send(200, f.read(), "text/html; charset=utf-8")
            except OSError:
                self._send(500, b"index.html missing", "text/plain")
        elif path == "/health":
            self._send(200, b"ok", "text/plain")
        elif path == "/api/state":
            with _lock:
                st = dict(_flash)
            running = st["state"] == "flashing"
            self._json(200, {
                "version": image_version(),
                # While flashing, the board legitimately drops off VID 0955 (it re-enumerates
                # as the flashing kernel). Reporting "board gone" then would be alarming and
                # wrong, so only report presence when we are not flashing.
                "board": (None if running else ("recovery" if board_present() else "absent")),
                "state": st["state"],
                "phase": current_phase(read_log()) if st["state"] != "idle" else "",
                "elapsed": int((st["ended"] or time.time()) - st["started"]) if st["started"] else 0,
                "rc": st["rc"],
                "reason": st["reason"],
            })
        elif path == "/api/log":
            q = parse_qs(urlparse(self.path).query)
            try:
                offset = max(0, int(q.get("offset", ["0"])[0]))
            except ValueError:
                offset = 0
            data = b""
            try:
                with open(LOG_FILE, "rb") as f:
                    f.seek(0, os.SEEK_END)
                    size = f.tell()
                    if offset > size:      # log was truncated by a new run
                        offset = 0
                    f.seek(offset)
                    data = f.read()
            except OSError:
                pass
            self._json(200, {"offset": offset + len(data),
                             "data": data.decode("utf-8", errors="replace")})
        else:
            self._send(404, b"not found", "text/plain")

    def do_POST(self):
        path = urlparse(self.path).path
        if path == "/api/flash":
            with _lock:
                if _flash["state"] == "flashing":
                    self._json(409, {"error": "a flash is already running"})
                    return
                if not board_present():
                    self._json(412, {"error": "no board in recovery mode"})
                    return
                # Claim the slot INSIDE the lock, before starting the thread. Two clicks that
                # land together must not both launch a flash -- double-flashing real hardware
                # is exactly the mistake this guards against.
                _flash.update({"state": "flashing", "started": time.time(), "ended": 0.0,
                               "rc": None, "reason": ""})
            threading.Thread(target=run_flash, daemon=True).start()
            threading.Thread(target=watchdog, daemon=True).start()
            self._json(202, {"state": "flashing"})

        elif path == "/api/cancel":
            with _lock:
                if _flash["state"] != "flashing":
                    self._json(409, {"error": "nothing is running"})
                    return
                p = _proc
            if p and p.poll() is None:
                try:
                    os.killpg(os.getpgid(p.pid), signal.SIGKILL)
                except OSError:
                    pass
            fail("Cancelled. The board was interrupted mid-flash — power-cycle it back into "
                 "recovery mode before trying again.")
            self._json(200, {"state": "failed"})
        else:
            self._send(404, b"not found", "text/plain")


if __name__ == "__main__":
    os.makedirs(STATE_DIR, exist_ok=True)
    # Start every boot with an empty log window. The log lives on the DATA partition, so it
    # survives a VM reboot -- and showing a previous run's output to someone who has just
    # powered the appliance on reads as "something is happening now", which is wrong and
    # actively misleading when the previous run failed. Keep one generation for diagnostics.
    try:
        if os.path.exists(LOG_FILE):
            os.replace(LOG_FILE, PREV_LOG)
    except OSError:
        pass
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
